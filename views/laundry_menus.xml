<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_laundry_landing" model="ir.actions.client">
        <field name="name">Laundry</field>
        <field name="tag">pos_laundry.landing</field>
    </record>

    <record id="action_laundry_workspace" model="ir.actions.server">
        <field name="name">Laundry Workspace</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pos.config"].action_open_selected_laundry_workspace()</field>
    </record>

    <record id="action_laundry_selected_orders" model="ir.actions.server">
        <field name="name">Laundry Orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pos.config"].action_open_selected_laundry_item("orders")</field>
    </record>

    <record id="action_laundry_selected_barcode" model="ir.actions.server">
        <field name="name">Enter Barcode</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pos.config"].action_open_selected_laundry_item("barcode")</field>
    </record>

    <record id="action_laundry_selected_scan_logs" model="ir.actions.server">
        <field name="name">Barcode Scan Logs</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pos.config"].action_open_selected_laundry_item("scan_logs")</field>
    </record>

    <record id="action_laundry_selected_settings" model="ir.actions.server">
        <field name="name">Laundry Settings</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pos.config"].action_open_selected_laundry_item("settings")</field>
    </record>


<!-- Main Laundry Menu -->
    <menuitem id="menu_laundry_root"
              name="Laundry"
              action="action_laundry_landing"
              sequence="10"/>

    <menuitem id="menu_laundry_workspace"
              name="Workspace"
              parent="menu_laundry_root"
              action="action_laundry_workspace"
              sequence="1"/>

    <!-- Orders -->
    <menuitem id="menu_laundry_orders_root"
              name="Orders"
              parent="menu_laundry_root"
              sequence="10"/>

              <!-- Order Types -->
    <menuitem id="menu_laundry_orders"
              name="Orders"
              parent="menu_laundry_orders_root"
              action="action_laundry_selected_orders"
              sequence="10"/>
     <!-- Barcode Scan Logs -->
    <menuitem id="menu_laundry_order_scan_log"
              name="Barcode Scan Logs"
              parent="menu_laundry_orders_root"
              action="action_laundry_selected_scan_logs"
              sequence="20"
              groups="point_of_sale.group_pos_manager"/>
    <menuitem
                id="menu_laundry_barcode_entry"
                name="Enter Barcode"
                parent="menu_laundry_root"
                action="action_laundry_selected_barcode"
                sequence="30"
            />
              



    <!-- Configuration -->
    <menuitem id="menu_laundry_configuration"
              name="Configuration"
              parent="menu_laundry_root"
              sequence="90"/>

    <menuitem id="menu_laundry_pos_order_title"
              name="Orders"
              parent="menu_laundry_configuration"
              sequence="9"/>

    <!-- Order Types -->
    <menuitem id="menu_laundry_order_type"
              name="Order Types"
              parent="menu_laundry_pos_order_title"
              action="action_laundry_order_type"
              sequence="10"/>

     <menuitem id="menu_laundry_order_status"
              name="Order Status"
              parent="menu_laundry_pos_order_title"
              action="action_laundry_order_status"
              sequence="20"/>
    <menuitem id="menu_laundry_order_payment_status"
              name="Order Payment Status"
              parent="menu_laundry_pos_order_title"
              action="action_laundry_order_payment_status"
              sequence="30"/>

   
     <menuitem id="menu_laundry_pos_product_title"
              name="Products"
              parent="menu_laundry_configuration"
              sequence="10"/>          
    <!-- POS Categories Action -->
    <record id="action_laundry_pos_categories" model="ir.actions.act_window">
        <field name="name">POS Categories</field>
        <field name="res_model">pos.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Products Action -->
    <record id="action_laundry_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- POS Categories -->
    <menuitem id="menu_laundry_pos_categories"
              name="POS Categories"
              parent="menu_laundry_pos_product_title"
              action="action_laundry_pos_categories"
              sequence="22"/>

    <!-- Products -->
    <menuitem id="menu_laundry_products"
              name="Products"
              parent="menu_laundry_pos_product_title"
              action="action_laundry_products"
              sequence="30"/>

    <!-- Laundry Settings Action -->
    <record id="action_laundry_configuration" model="ir.actions.act_window">
        <field name="name">Laundry Settings</field>
        <field name="res_model">laundry.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_laundry_settings"
              name="Laundry Settings"
              parent="menu_laundry_configuration"
              action="action_laundry_selected_settings"
              sequence="5"/>
    <!-- Settings -->

  
    


</odoo>

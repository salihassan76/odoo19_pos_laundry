<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_config_form_laundry_only" model="ir.ui.view">
        <field name="name">pos.config.form.laundry.only</field>
        <field name="model">pos.config</field>
        <!--
            Kept as an inactive compatibility record so upgrades deactivate the
            former standalone form in existing databases.  A standalone
            pos.config form can be selected by Odoo's "+ New Shop" action and
            must not replace the standard Point of Sale creation dialog.
        -->
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <form string="Laundry POS" create="false" duplicate="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_laundry_configuration" type="object"
                                class="oe_stat_button" icon="fa-cogs" string="Laundry Settings"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group><field name="enable_laundry_workflow"/></group>
                    <group string="Laundry Configuration" invisible="not enable_laundry_workflow">
                        <field name="laundry_configuration_ids" readonly="1">
                            <list create="false" delete="false">
                                <field name="name"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

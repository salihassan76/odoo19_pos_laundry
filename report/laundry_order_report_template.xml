<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_laundry_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-call="web.external_layout">

                    <div class="page">

                        <!-- ==================================================
                             Report Header
                        =================================================== -->
                        <div class="text-center mb-4">

                            <h2>Laundry Order</h2>

                            <h3>
                                <span t-field="order.name"/>
                            </h3>

                            <div t-if="order.barcode" class="mt-2 mb-3">
                                <img
                                    t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=100&amp;humanreadable=1' % order.barcode"
                                    style="width: 300px; height: 55px;"
                                    alt="Order Barcode"
                                />
                            </div>

                            <div t-if="not order.barcode" class="text-muted">
                                No barcode assigned
                            </div>

                        </div>

                        <!-- ==================================================
                             Order Information
                        =================================================== -->
                        <div class="row mb-3">

                            <div class="col-6">

                                <div class="mb-1">
                                    <strong>Customer:</strong>
                                    <span t-field="order.customer_id"/>
                                </div>

                                <div class="mb-1">
                                    <strong>Phone:</strong>
                                    <span t-esc="order.customer_id.phone or ''"/>
                                </div>

                                <div class="mb-1">
                                    <strong>Order Type:</strong>
                                    <span t-field="order.order_type_id"/>
                                </div>

                            </div>

                            <div class="col-6">

                                <div class="mb-1">
                                    <strong>Received:</strong>
                                    <span
                                        t-field="order.order_datetime"
                                        t-options="{'widget': 'datetime'}"
                                    />
                                </div>

                                <div class="mb-1">
                                    <strong>Order Status:</strong>
                                    <span t-field="order.status_id"/>
                                </div>

                                <div class="mb-1">
                                    <strong>Payment Status:</strong>
                                    <span t-field="order.payment_status_id"/>
                                </div>

                            </div>

                        </div>

                        <!-- ==================================================
                             Order Lines
                        =================================================== -->
                        <table class="table table-sm table-bordered">

                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr t-foreach="order.order_line_ids" t-as="line">

                                    <td>
                                        <span t-field="line.product_id"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                    </td>

                                    <td class="text-end">
                                        <span
                                            t-field="line.price_unit"
                                            t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"
                                        />
                                    </td>

                                    <td class="text-end">
                                        <span
                                            t-field="line.price_subtotal"
                                            t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"
                                        />
                                    </td>

                                </tr>

                                <tr t-if="not order.order_line_ids">
                                    <td colspan="4" class="text-center">
                                        No order lines found.
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                        <!-- ==================================================
                             Totals
                        =================================================== -->
                        <div class="row mt-3">

                            <div class="col-7"/>

                            <div class="col-5">

                                <table class="table table-sm">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <strong>Total</strong>
                                            </td>

                                            <td class="text-end">
                                                <strong>
                                                    <span
                                                        t-field="order.total_amount"
                                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"
                                                    />
                                                </strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>

                        </div>

                        <!-- ==================================================
                             Notes
                        =================================================== -->
                        <div t-if="order.order_note" class="mt-3">

                            <strong>Customer Note:</strong>

                            <div class="mt-1">
                                <span t-field="order.order_note"/>
                            </div>

                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
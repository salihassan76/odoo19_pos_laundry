<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_laundry.pos_homescreen">

        <div class="d-flex flex-column h-100 p-4 bg-100">

            <!-- Main Content -->
            <div class="overflow-y-auto flex-grow-1 rounded-bottom-3 bg-view p-3">

                <div class="d-flex justify-content-center">

                    <div class="card shadow-sm border-0 w-100"
                         style="max-width: 1200px;">

                        <div class="card-body">

                            <div class="o_form_sheet_bg">

                                <div class="o_form_sheet p-4 mx-auto"
                                     style="max-width: 1100px;">

                                    <!-- CUSTOMER DETAILS -->
                                    <div class="mb-4">

                                        <div class="border rounded p-3 bg-light"
                                             t-on-click="openCustomerDetails"
                                             style="
                                                cursor: pointer;
                                                transition: all 0.2s ease;
                                             "
                                             onmouseover="this.classList.add('shadow-sm','border-primary')"
                                             onmouseout="this.classList.remove('shadow-sm','border-primary')">

                                            <t t-if="state.customer">

                                                <div class="d-flex align-items-center justify-content-between">

                                                    <!-- Customer Name -->
                                                    <div class="d-flex align-items-center gap-3">

                                                        <i class="fa fa-user-circle fa-2x text-primary"/>

                                                        <div>

                                                            <h4 class="mb-0">
                                                                <t t-out="state.customer.name"/>
                                                            </h4>

                                                            <div class="text-muted small">
                                                                Customer ID:
                                                                <t t-out="state.customer.id"/>
                                                            </div>

                                                        </div>

                                                    </div>

                                                    <!-- Contact -->
                                                    <div class="text-end">

                                                        <div class="text-muted small">
                                                            Contact
                                                        </div>

                                                        <div class="fw-bold">
                                                            <t t-out="state.customer.phone || '-'"/>
                                                        </div>

                                                    </div>

                                                </div>

                                            </t>

                                            <t t-else="">

                                                <div class="d-flex align-items-center gap-3">

                                                    <i class="fa fa-user-circle fa-2x text-muted"/>

                                                    <div>

                                                        <h4 class="mb-0 text-muted">
                                                            No Customer Selected
                                                        </h4>

                                                        <div class="text-muted small">
                                                            Select a customer to view their orders
                                                        </div>

                                                    </div>

                                                </div>

                                            </t>

                                        </div>

                                    </div>


                                    <!-- ORDERS SUMMARY -->
                                    <div>

                                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">

                                            <h4 class="mb-0">

                                                <i class="fa fa-list-alt me-2 text-primary"/>

                                                Orders

                                            </h4>

                                        </div>


                                        <!-- Orders grouped by status -->
                                        <t t-foreach="state.ordersByStatus"
                                           t-as="status"
                                           t-key="status.status_id">

                                            <t t-if="status.orders.length">

                                                <div class="mb-4">

                                                    <!-- Status Header -->
                                                    <h5 t-att-class="'border-bottom pb-2 mb-3 text-' + (status.status_color || 'primary')">

                                                        <t t-esc="status.status_name"/>

                                                        <small class="text-muted ms-1">
                                                            (<t t-esc="status.period_label"/>)
                                                        </small>

                                                    </h5>


                                                    <!-- Order Cards -->
                                                    <div class="d-flex flex-wrap gap-2">

                                                        <t t-foreach="status.orders"
                                                           t-as="order"
                                                           t-key="order.id">

                                                            <button class="btn btn-light border shadow-sm text-start px-3 py-2"
                                                                    style="min-width: 240px;"
                                                                    t-on-click="() => this.openLaundryOrder(order)">

                                                                <div class="fw-bold">

                                                                    <i t-att-class="'fa ' + order.order_type_icon + ' me-2 ' + order.order_type_color"/>

                                                                    <t t-esc="order.name"/>

                                                                </div>

                                                                <div class="small text-muted">

                                                                    <t t-esc="order.order_datetime"/>

                                                                </div>

                                                                <div class="fw-bold text-success">

                                                                    BD
                                                                    <t t-esc="formatAmount(order.total_amount)"/>

                                                                </div>

                                                            </button>

                                                        </t>

                                                    </div>

                                                </div>

                                            </t>

                                        </t>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ACTION BUTTONS -->
            <!-- Kept unchanged -->

            <div class="border-top bg-view p-3">

                <div class="row g-3 justify-content-center">

                    <t t-foreach="state.orderTypes"
                       t-as="orderType"
                       t-key="orderType.id">

                        <div class="col-6 col-md-4 col-xl-2">

                            <button class="btn btn-light border w-100 h-100 py-4 shadow-sm"
                                    t-on-click="() => this.selectOrderType(orderType)">

                                <div class="d-flex flex-column align-items-center">

                                    <i t-att-class="'fa ' + (orderType.icon_class || 'fa-shopping-basket') + ' ' + (orderType.icon_color || 'text-primary') + ' fa-2x mb-2'"/>

                                    <span class="fw-bold">
                                        <t t-esc="orderType.name"/>
                                    </span>

                                </div>

                            </button>

                        </div>

                    </t>

                </div>

            </div>

        </div>

    </t>

</templates>
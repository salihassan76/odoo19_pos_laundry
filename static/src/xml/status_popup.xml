<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_laundry.LaundryStatusPopup">

        <Dialog
            title="false"
            size="'lg'"
            contentClass="'laundry-status-dialog'"
        >
            <div
                class="laundry-status-popup"
                tabindex="0"
                t-on-keydown="onKeydown"
            >

                <!-- ==================================================
                     Header
                =================================================== -->

                <header class="laundry-status-header">

                    <div class="laundry-header-title">

                        <div class="laundry-header-icon">
                            <i class="fa fa-barcode"/>
                        </div>

                        <div>
                            <h2
                                class="laundry-popup-title"
                                t-esc="props.title"
                            />

                            <div class="laundry-popup-subtitle">
                                Review the order before confirming
                            </div>
                        </div>

                    </div>

                    <div class="laundry-header-actions">

                        <div
                            t-attf-class="
                                scanner-active-badge
                                #{state.processing ? 'processing' : 'active'}
                            "
                        >
                            <span class="scanner-active-dot"/>

                            <span t-if="state.processing">
                                Updating Status
                            </span>

                            <span t-else="">
                                Scanner Active
                            </span>
                        </div>

                        <button
                            type="button"
                            class="laundry-close-button"
                            t-att-disabled="state.processing"
                            t-on-click="cancel"
                            title="Close"
                        >
                            <i class="fa fa-times"/>
                        </button>

                    </div>

                </header>


                <!-- ==================================================
                     Order Header
                =================================================== -->

                <section class="laundry-order-heading">

                    <div class="laundry-order-primary">

                        <div class="laundry-section-label">
                            Laundry Order
                        </div>

                        <h1
                            class="laundry-order-number"
                            t-esc="order.name || order.order_name || '-'"
                        />

                        <div class="laundry-order-badges">

                            <span
                                t-if="
                                    order.payment_status_name ||
                                    order.payment_status?.name
                                "
                                class="laundry-badge laundry-badge-payment"
                                t-esc="
                                    order.payment_status_name ||
                                    order.payment_status?.name
                                "
                            />

                            <span
                                t-if="
                                    order.order_type_name ||
                                    order.order_type?.name
                                "
                                class="laundry-badge laundry-badge-type"
                                t-esc="
                                    order.order_type_name ||
                                    order.order_type?.name
                                "
                            />

                        </div>

                    </div>

                    <div class="laundry-barcode-summary">

                        <div class="laundry-barcode-icon">
                            <i class="fa fa-barcode"/>
                        </div>

                        <div>
                            <div
                                class="laundry-barcode-value"
                                t-esc="props.scannedBarcode || '-'"
                            />

                            <div class="laundry-barcode-caption">
                                Barcode scanned successfully
                            </div>
                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Customer and Order Information
                =================================================== -->

                <section class="laundry-information-card">

                    <div class="laundry-information-grid">

                        <!-- Customer -->

                        <div class="laundry-information-item customer">

                            <div class="laundry-information-icon customer">
                                <i class="fa fa-user"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Customer
                                </div>

                                <div
                                    class="laundry-information-value"
                                    t-esc="
                                        order.customer_name ||
                                        order.partner_name ||
                                        order.customer?.name ||
                                        '-'
                                    "
                                />

                                <div
                                    t-if="
                                        order.customer_phone ||
                                        order.partner_phone ||
                                        order.customer?.phone ||
                                        order.customer?.mobile
                                    "
                                    class="laundry-information-secondary"
                                >
                                    <i class="fa fa-phone"/>

                                    <span
                                        t-esc="
                                            order.customer_phone ||
                                            order.partner_phone ||
                                            order.customer?.phone ||
                                            order.customer?.mobile
                                        "
                                    />
                                </div>

                                <div
                                    t-else=""
                                    class="laundry-information-secondary"
                                >
                                    No phone number
                                </div>

                            </div>

                        </div>


                        <!-- Items -->

                        <div class="laundry-information-item">

                            <div class="laundry-information-icon items">
                                <i class="fa fa-shopping-basket"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Items
                                </div>

                                <div class="laundry-information-value">
                                    <t
                                        t-esc="
                                            order.item_count ??
                                            order.total_items ??
                                            order.quantity ??
                                            0
                                        "
                                    />
                                    <span>
                                        Items
                                    </span>
                                </div>

                                <div
                                    class="laundry-information-secondary"
                                    t-esc="
                                        order.order_type_name ||
                                        order.order_type?.name ||
                                        'Laundry Service'
                                    "
                                />

                            </div>

                        </div>


                        <!-- Amount -->

                        <div class="laundry-information-item">

                            <div class="laundry-information-icon amount">
                                <i class="fa fa-money"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Total Amount
                                </div>

                                <div
                                    class="laundry-information-value"
                                    t-esc="
                                        formatAmount(
                                            order.total_amount ??
                                            order.amount_total ??
                                            0
                                        )
                                    "
                                />

                                <div
                                    class="laundry-information-secondary"
                                    t-esc="
                                        order.payment_status_name ||
                                        order.payment_status?.name ||
                                        'Payment status unavailable'
                                    "
                                />

                            </div>

                        </div>


                        <!-- POS -->

                        <div class="laundry-information-item">

                            <div class="laundry-information-icon pos">
                                <i class="fa fa-desktop"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Origin POS
                                </div>

                                <div
                                    class="laundry-information-value"
                                    t-esc="
                                        order.pos_config_name ||
                                        order.pos_name ||
                                        order.pos_config?.name ||
                                        '-'
                                    "
                                />

                                <div
                                    class="laundry-information-secondary"
                                    t-esc="
                                        order.pos_description ||
                                        order.branch_name ||
                                        order.company_name ||
                                        'Laundry POS'
                                    "
                                />

                            </div>

                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Status Confirmation
                =================================================== -->

                <section class="laundry-status-confirmation">

                    <div class="laundry-status-heading">

                        <div class="laundry-status-heading-icon">
                            <i class="fa fa-exchange"/>
                        </div>

                        <div>
                            <h3>
                                Confirm Status Change
                            </h3>

                            <p>
                                This order will move to its configured next
                                workflow status.
                            </p>
                        </div>

                    </div>


                    <div
                        t-if="hasNextStatus"
                        class="laundry-status-transition"
                    >

                        <!-- Current Status -->

                        <div
                            t-attf-class="
                                laundry-status-card current
                                #{getStatusColorClass(currentStatus)}
                            "
                            t-att-style="getStatusStyle(currentStatus)"
                        >

                            <div class="laundry-status-card-label">
                                Current Status
                            </div>

                            <div class="laundry-status-card-body">

                                <div class="laundry-status-card-icon current">
                                    <i
                                        t-att-class="
                                            currentStatus.icon_class ||
                                            currentStatus.icon ||
                                            'fa fa-spinner'
                                        "
                                    />
                                </div>

                                <div>
                                    <div
                                        class="laundry-status-card-name"
                                        t-esc="currentStatus.name || '-'"
                                    />

                                    <div
                                        class="laundry-status-card-description"
                                        t-esc="
                                            currentStatus.description ||
                                            'The order is currently in this status.'
                                        "
                                    />
                                </div>

                            </div>

                            <div
                                t-if="
                                    currentStatus.since ||
                                    currentStatus.changed_at ||
                                    currentStatus.status_date
                                "
                                class="laundry-status-card-footer"
                            >
                                <i class="fa fa-clock-o"/>

                                <span>
                                    Since
                                </span>

                                <span
                                    t-esc="
                                        currentStatus.since ||
                                        currentStatus.changed_at ||
                                        currentStatus.status_date
                                    "
                                />
                            </div>

                        </div>


                        <!-- Arrow -->

                        <div class="laundry-transition-arrow">

                            <div class="laundry-transition-line"/>

                            <div class="laundry-transition-circle">
                                <i class="fa fa-angle-right"/>
                            </div>

                            <div class="laundry-transition-line"/>

                        </div>


                        <!-- Next Status -->

                        <div
                            t-attf-class="
                                laundry-status-card next
                                #{getStatusColorClass(nextStatus)}
                            "
                            t-att-style="getStatusStyle(nextStatus)"
                        >

                            <div class="laundry-status-card-label">
                                Next Status
                            </div>

                            <div class="laundry-status-card-body">

                                <div class="laundry-status-card-icon next">
                                    <i
                                        t-att-class="
                                            nextStatus.icon_class ||
                                            nextStatus.icon ||
                                            'fa fa-check'
                                        "
                                    />
                                </div>

                                <div>
                                    <div
                                        class="laundry-status-card-name"
                                        t-esc="nextStatus.name || '-'"
                                    />

                                    <div
                                        class="laundry-status-card-description"
                                        t-esc="
                                            nextStatus.description ||
                                            'The order will move to this status.'
                                        "
                                    />
                                </div>

                            </div>

                            <div class="laundry-status-card-footer enabled">
                                <i class="fa fa-barcode"/>

                                <span>
                                    Barcode update enabled
                                </span>
                            </div>

                        </div>

                    </div>


                    <!-- No next status available -->

                    <div
                        t-else=""
                        class="laundry-no-next-status"
                    >
                        <div class="laundry-no-next-status-icon">
                            <i class="fa fa-exclamation-circle"/>
                        </div>

                        <div>
                            <div class="laundry-no-next-status-title">
                                No next status available
                            </div>

                            <div class="laundry-no-next-status-text">
                                This order does not have a barcode-enabled next
                                workflow status.
                            </div>
                        </div>
                    </div>


                    <div
                        t-if="hasNextStatus"
                        class="laundry-status-warning"
                    >

                        <div class="laundry-status-warning-icon">
                            <i class="fa fa-info-circle"/>
                        </div>

                        <div>
                            <div class="laundry-status-warning-title">
                                Status update confirmation
                            </div>

                            <div class="laundry-status-warning-text">
                                Confirming will change the order status from

                                <strong
                                    t-esc="currentStatus.name || '-'"
                                />

                                to

                                <strong
                                    t-esc="nextStatus.name || '-'"
                                />.
                            </div>
                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Error
                =================================================== -->

                <div
                    t-if="state.errorMessage"
                    class="laundry-error-message"
                >
                    <div class="laundry-error-icon">
                        <i class="fa fa-exclamation-triangle"/>
                    </div>

                    <div>
                        <div class="laundry-error-title">
                            Status update failed
                        </div>

                        <div
                            class="laundry-error-text"
                            t-esc="state.errorMessage"
                        />
                    </div>
                </div>


                <!-- ==================================================
                     Scan Information
                =================================================== -->

                <section class="laundry-scan-information">

                    <div class="laundry-scan-item">

                        <div class="laundry-scan-icon operator">
                            <i class="fa fa-user-o"/>
                        </div>

                        <div>
                            <div class="laundry-scan-label">
                                Operator
                            </div>

                            <div
                                class="laundry-scan-value"
                                t-esc="
                                    order.operator_name ||
                                    order.user_name ||
                                    order.cashier_name ||
                                    '-'
                                "
                            />
                        </div>

                    </div>


                    <div class="laundry-scan-item">

                        <div class="laundry-scan-icon time">
                            <i class="fa fa-clock-o"/>
                        </div>

                        <div>
                            <div class="laundry-scan-label">
                                Scan Time
                            </div>

                            <div
                                class="laundry-scan-value"
                                t-esc="
                                    order.scan_time ||
                                    order.scanned_at ||
                                    '-'
                                "
                            />
                        </div>

                    </div>


                    <div class="laundry-scan-item">

                        <div class="laundry-scan-icon device">
                            <i class="fa fa-tablet"/>
                        </div>

                        <div>
                            <div class="laundry-scan-label">
                                Device
                            </div>

                            <div
                                class="laundry-scan-value"
                                t-esc="
                                    order.device_name ||
                                    order.pos_config_name ||
                                    order.pos_name ||
                                    '-'
                                "
                            />
                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Footer
                =================================================== -->

                <footer class="laundry-status-footer">

                    <div class="laundry-keyboard-help">
                        <i class="fa fa-keyboard-o"/>

                        <span>
                            Press Enter to confirm or Escape to cancel
                        </span>
                    </div>

                    <div class="laundry-footer-actions">

                        <button
                            type="button"
                            class="laundry-button laundry-button-cancel"
                            t-att-disabled="state.processing"
                            t-on-click="cancel"
                        >
                            <i class="fa fa-times"/>

                            <span>
                                Cancel
                            </span>
                        </button>

                        <button
                            type="button"
                            class="laundry-button laundry-button-confirm"
                            t-att-disabled="!canConfirm"
                            t-on-click="confirm"
                        >

                            <t t-if="state.processing">
                                <i class="fa fa-spinner fa-spin"/>

                                <span>
                                    Updating...
                                </span>
                            </t>

                            <t t-elif="hasNextStatus">
                                <i class="fa fa-check"/>

                                <span>
                                    Confirm
                                </span>

                                <span
                                    t-esc="nextStatus.name"
                                />
                            </t>

                            <t t-else="">
                                <i class="fa fa-ban"/>

                                <span>
                                    No Next Status
                                </span>
                            </t>

                        </button>

                    </div>

                </footer>

            </div>

        </Dialog>

    </t>

</templates>
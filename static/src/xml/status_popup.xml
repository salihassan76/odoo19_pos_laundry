<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_laundry.LaundryStatusPopup">

        <Dialog
            title="false"
            size="'lg'"
            contentClass="'laundry-status-dialog'"
        >
            <div
                class="laundry-status-popup"
                tabindex="0"
                t-on-keydown="onKeydown"
            >

                <!-- ==================================================
                     Header
                =================================================== -->

                <header class="laundry-status-header">

                    <div class="laundry-header-title">

                        <div class="laundry-header-icon">
                            <i class="fa fa-barcode"/>
                        </div>

                        <div>
                            <h2 class="laundry-popup-title">
                                Confirm Status Update
                            </h2>

                            <div class="laundry-popup-subtitle">
                                Review the order before confirming
                            </div>
                        </div>

                    </div>

                    <div class="laundry-header-actions">

                        <div class="scanner-active-badge">
                            <span class="scanner-active-dot"/>

                            <span>
                                Scanner Active
                            </span>
                        </div>

                        <button
                            type="button"
                            class="laundry-close-button"
                            t-att-disabled="state.processing"
                            t-on-click="cancel"
                            title="Close"
                        >
                            <i class="fa fa-times"/>
                        </button>

                    </div>

                </header>


                <!-- ==================================================
                     Order Header
                =================================================== -->

                <section class="laundry-order-heading">

                    <div class="laundry-order-primary">

                        <div class="laundry-section-label">
                            Laundry Order
                        </div>

                        <h1 class="laundry-order-number">
                            WS/2026/000482
                        </h1>

                        <div class="laundry-order-badges">

                            <span class="laundry-badge laundry-badge-payment">
                                Unpaid
                            </span>

                            <span class="laundry-badge laundry-badge-type">
                                Washing &amp; Ironing
                            </span>

                        </div>

                    </div>

                    <div class="laundry-barcode-summary">

                        <div class="laundry-barcode-icon">
                            <i class="fa fa-barcode"/>
                        </div>

                        <div>
                            <div class="laundry-barcode-value">
                                LND0000000482
                            </div>

                            <div class="laundry-barcode-caption">
                                Barcode scanned successfully
                            </div>
                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Customer and Order Information
                =================================================== -->

                <section class="laundry-information-card">

                    <div class="laundry-information-grid">

                        <!-- Customer -->

                        <div class="laundry-information-item customer">

                            <div class="laundry-information-icon customer">
                                <i class="fa fa-user"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Customer
                                </div>

                                <div class="laundry-information-value">
                                    Ahmed Ali
                                </div>

                                <div class="laundry-information-secondary">
                                    <i class="fa fa-phone"/>
                                    <span>+973 3600 1234</span>
                                </div>

                            </div>

                        </div>


                        <!-- Items -->

                        <div class="laundry-information-item">

                            <div class="laundry-information-icon items">
                                <i class="fa fa-shopping-basket"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Items
                                </div>

                                <div class="laundry-information-value">
                                    12 Items
                                </div>

                                <div class="laundry-information-secondary">
                                    Washing &amp; Ironing
                                </div>

                            </div>

                        </div>


                        <!-- Amount -->

                        <div class="laundry-information-item">

                            <div class="laundry-information-icon amount">
                                <i class="fa fa-money"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Total Amount
                                </div>

                                <div class="laundry-information-value">
                                    BD 4.800
                                </div>

                                <div class="laundry-information-secondary">
                                    Payment pending
                                </div>

                            </div>

                        </div>


                        <!-- POS -->

                        <div class="laundry-information-item">

                            <div class="laundry-information-icon pos">
                                <i class="fa fa-desktop"/>
                            </div>

                            <div class="laundry-information-content">

                                <div class="laundry-information-label">
                                    Origin POS
                                </div>

                                <div class="laundry-information-value">
                                    POS-01
                                </div>

                                <div class="laundry-information-secondary">
                                    Front Counter
                                </div>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Status Confirmation
                =================================================== -->

                <section class="laundry-status-confirmation">

                    <div class="laundry-status-heading">

                        <div class="laundry-status-heading-icon">
                            <i class="fa fa-exchange"/>
                        </div>

                        <div>
                            <h3>
                                Confirm Status Change
                            </h3>

                            <p>
                                This order will move to its configured next
                                workflow status.
                            </p>
                        </div>

                    </div>


                    <div class="laundry-status-transition">

                        <!-- Current Status -->

                        <div class="laundry-status-card current">

                            <div class="laundry-status-card-label">
                                Current Status
                            </div>

                            <div class="laundry-status-card-body">

                                <div class="laundry-status-card-icon current">
                                    <i class="fa fa-spinner"/>
                                </div>

                                <div>
                                    <div class="laundry-status-card-name">
                                        In Progress
                                    </div>

                                    <div class="laundry-status-card-description">
                                        Order is currently being processed
                                    </div>
                                </div>

                            </div>

                            <div class="laundry-status-card-footer">
                                <i class="fa fa-clock-o"/>

                                <span>
                                    Since 21 Jul 2026, 10:20 AM
                                </span>
                            </div>

                        </div>


                        <!-- Arrow -->

                        <div class="laundry-transition-arrow">

                            <div class="laundry-transition-line"/>

                            <div class="laundry-transition-circle">
                                <i class="fa fa-angle-right"/>
                            </div>

                            <div class="laundry-transition-line"/>

                        </div>


                        <!-- Next Status -->

                        <div class="laundry-status-card next">

                            <div class="laundry-status-card-label">
                                Next Status
                            </div>

                            <div class="laundry-status-card-body">

                                <div class="laundry-status-card-icon next">
                                    <i class="fa fa-check"/>
                                </div>

                                <div>
                                    <div class="laundry-status-card-name">
                                        Ready
                                    </div>

                                    <div class="laundry-status-card-description">
                                        Order is ready for customer pickup
                                    </div>
                                </div>

                            </div>

                            <div class="laundry-status-card-footer enabled">
                                <i class="fa fa-barcode"/>

                                <span>
                                    Barcode update enabled
                                </span>
                            </div>

                        </div>

                    </div>


                    <div class="laundry-status-warning">

                        <div class="laundry-status-warning-icon">
                            <i class="fa fa-info-circle"/>
                        </div>

                        <div>
                            <div class="laundry-status-warning-title">
                                Status update confirmation
                            </div>

                            <div class="laundry-status-warning-text">
                                Confirming will change the order status from
                                In Progress to Ready.
                            </div>
                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Error
                =================================================== -->

                <div
                    t-if="state.errorMessage"
                    class="laundry-error-message"
                >
                    <div class="laundry-error-icon">
                        <i class="fa fa-exclamation-triangle"/>
                    </div>

                    <div>
                        <div class="laundry-error-title">
                            Status update failed
                        </div>

                        <div
                            class="laundry-error-text"
                            t-esc="state.errorMessage"
                        />
                    </div>
                </div>


                <!-- ==================================================
                     Scan Information
                =================================================== -->

                <section class="laundry-scan-information">

                    <div class="laundry-scan-item">

                        <div class="laundry-scan-icon operator">
                            <i class="fa fa-user-o"/>
                        </div>

                        <div>
                            <div class="laundry-scan-label">
                                Operator
                            </div>

                            <div class="laundry-scan-value">
                                Sayed Ali Hassan
                            </div>
                        </div>

                    </div>


                    <div class="laundry-scan-item">

                        <div class="laundry-scan-icon time">
                            <i class="fa fa-clock-o"/>
                        </div>

                        <div>
                            <div class="laundry-scan-label">
                                Scan Time
                            </div>

                            <div class="laundry-scan-value">
                                21 Jul 2026, 11:25 AM
                            </div>
                        </div>

                    </div>


                    <div class="laundry-scan-item">

                        <div class="laundry-scan-icon device">
                            <i class="fa fa-tablet"/>
                        </div>

                        <div>
                            <div class="laundry-scan-label">
                                Device
                            </div>

                            <div class="laundry-scan-value">
                                POS-01
                            </div>
                        </div>

                    </div>

                </section>


                <!-- ==================================================
                     Footer
                =================================================== -->

                <footer class="laundry-status-footer">

                    <div class="laundry-keyboard-help">
                        <i class="fa fa-keyboard-o"/>

                        <span>
                            Press Enter to confirm or Escape to cancel
                        </span>
                    </div>

                    <div class="laundry-footer-actions">

                        <button
                            type="button"
                            class="laundry-button laundry-button-cancel"
                            t-att-disabled="state.processing"
                            t-on-click="cancel"
                        >
                            <i class="fa fa-times"/>

                            <span>
                                Cancel
                            </span>
                        </button>

                        <button
                            type="button"
                            class="laundry-button laundry-button-confirm"
                            t-att-disabled="!canConfirm"
                            t-on-click="confirm"
                        >

                            <t t-if="state.processing">
                                <i class="fa fa-spinner fa-spin"/>

                                <span>
                                    Updating...
                                </span>
                            </t>

                            <t t-else="">
                                <i class="fa fa-check"/>

                                <span>
                                    Confirm Ready
                                </span>
                            </t>

                        </button>

                    </div>

                </footer>

            </div>

        </Dialog>

    </t>

</templates>
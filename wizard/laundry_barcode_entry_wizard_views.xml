<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record
        id="view_laundry_barcode_entry_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">laundry.barcode.entry.wizard.form</field>
        <field name="model">laundry.barcode.entry.wizard</field>

        <field name="arch" type="xml">
            <form string="Enter Laundry Barcode">
                <group>
                    <field
                        name="barcode"
                        placeholder="LND0000000001"
                    />
                </group>

                <footer>
                    <button
                        name="action_open_order"
                        string="Open Order"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_laundry_barcode_entry_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Enter Barcode</field>
        <field name="res_model">laundry.barcode.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>